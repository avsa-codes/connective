// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Module 1 : Authentication & Access Control

model User {
  id                  String    @id @default(uuid()) @db.Uuid
  name                String
  email               String    @unique
  emailVerified       Boolean   @default(false)
  phoneNumber         String?   @unique
  phoneNumberVerified Boolean?  @default(false)
  image               String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  sessions            Session[]
  accounts            Account[]

  platformAdminAccess          PlatformAdminAccess?
  ownedOrganization            Organization?
  grantedPlatformAdminAccess   PlatformAdminAccess[] @relation("PlatformAdminGrantedBy")
  revokedPlatformAdminAccess   PlatformAdminAccess[] @relation("PlatformAdminRevokedBy")
  uploadedMediaAssets          MediaAsset[]
  updatedWebsiteDrafts         WebsiteDraft[]
  publishedWebsiteVersions     WebsiteVersion[]
  createdLeads                 Lead[]
  createdLeadFollowUps         LeadFollowUp[]
  createdLeadNotes             LeadNote[]
  createdAvailabilitySlots     AvailabilitySlot[]
  bookingActivities            BookingActivity[]
  aiContentGenerations         AIContentGeneration[]
  receivedNotifications        Notification[]
  connectedIntegrationAccounts IntegrationAccount[]
  auditLogs                    AuditLog[]

  @@map("user")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model PlatformAdminAccess {
  id              String              @id @default(uuid()) @db.Uuid
  userId          String              @unique @db.Uuid
  status          PlatformAdminStatus @default(ACTIVE)
  grantedAt       DateTime            @default(now())
  revokedAt       DateTime?
  grantedByUserId String?             @db.Uuid
  revokedByUserId String?             @db.Uuid
  reason          String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  user      User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  grantedBy User? @relation("PlatformAdminGrantedBy", fields: [grantedByUserId], references: [id], onDelete: SetNull)
  revokedBy User? @relation("PlatformAdminRevokedBy", fields: [revokedByUserId], references: [id], onDelete: SetNull)

  @@map("platform_admin_access")
}

// Module 2 : Organizations & Business Profiles

model Organization {
  id               String             @id @default(uuid()) @db.Uuid
  ownerUserId      String             @unique @db.Uuid
  businessName     String
  businessCategory BusinessCategory
  status           OrganizationStatus @default(ACTIVE)
  onboardingStatus OnboardingStatus   @default(PENDING)
  timezone         String             @default("Asia/Kolkata")
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  owner                      User                        @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  businessProfile            BusinessProfile?
  businessHours              BusinessHours[]
  website                    Website?
  catalogueCategories        CatalogueCategory[]
  products                   Product[]
  salonServices              SalonService[]
  mediaAssets                MediaAsset[]
  leads                      Lead[]
  leadFollowUps              LeadFollowUp[]
  leadNotes                  LeadNote[]
  availabilitySlots          AvailabilitySlot[]
  bookings                   Booking[]
  bookingActivities          BookingActivity[]
  aiContentGenerations       AIContentGeneration[]
  notifications              Notification[]
  outboxEvents               OutboxEvent[]
  integrationAccounts        IntegrationAccount[]
  integrationResources       IntegrationResource[]
  integrationSyncJobs        IntegrationSyncJob[]
  integrationMetricSnapshots IntegrationMetricSnapshot[]
  whatsAppConversations      WhatsAppConversation[]
  subscriptions              Subscription[]
  usageRecords               UsageRecord[]
  paymentCustomers           PaymentCustomer[]
  payments                   Payment[]
  invoices                   Invoice[]
  auditLogs                  AuditLog[]

  @@map("organization")
}

model BusinessProfile {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @unique @db.Uuid
  displayName    String
  description    String?
  logoAssetId    String?  @db.Uuid
  contactEmail   String?
  contactPhone   String?
  addressLine1   String?
  addressLine2   String?
  city           String?
  state          String?
  postalCode     String?
  countryCode    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  logoAsset    MediaAsset?  @relation(fields: [logoAssetId], references: [id], onDelete: SetNull)

  @@map("business_profile")
}

model BusinessHours {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  dayOfWeek      DayOfWeek
  opensAt        DateTime  @db.Time(0)
  closesAt       DateTime  @db.Time(0)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, dayOfWeek])
  @@map("business_hours")
}

// Module 03 - Websites & Publishing

model Website {
  id                        String        @id @default(uuid()) @db.Uuid
  organizationId            String        @unique @db.Uuid
  selectedTemplateReleaseId String        @db.Uuid
  status                    WebsiteStatus @default(DRAFT)
  currentPublishedVersionId String?       @unique @db.Uuid
  createdAt                 DateTime      @default(now())
  updatedAt                 DateTime      @updatedAt

  organization            Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  selectedTemplateRelease WebsiteTemplateRelease @relation("WebsiteSelectedTemplateRelease", fields: [selectedTemplateReleaseId], references: [id], onDelete: Restrict)
  currentPublishedVersion WebsiteVersion?        @relation("WebsiteCurrentPublishedVersion", fields: [currentPublishedVersionId], references: [id], onDelete: SetNull)
  draft                   WebsiteDraft?
  versions                WebsiteVersion[]       @relation("WebsiteVersions")
  domains                 WebsiteDomain[]

  @@map("website")
}

model WebsiteTemplate {
  id               String                @id @default(uuid()) @db.Uuid
  name             String
  slug             String                @unique
  businessCategory BusinessCategory
  status           WebsiteTemplateStatus @default(DRAFT)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  releases WebsiteTemplateRelease[]

  @@map("website_template")
}

model WebsiteTemplateRelease {
  id            String                @id @default(uuid()) @db.Uuid
  templateId    String                @db.Uuid
  versionNumber Int
  status        TemplateReleaseStatus @default(DRAFT)
  releaseNotes  String?
  releasedAt    DateTime?
  createdAt     DateTime              @default(now())

  template           WebsiteTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  selectedByWebsites Website[]        @relation("WebsiteSelectedTemplateRelease")
  drafts             WebsiteDraft[]
  versions           WebsiteVersion[]

  @@unique([templateId, versionNumber])
  @@index([templateId, status])
  @@map("website_template_release")
}

model WebsiteDraft {
  id                String   @id @default(uuid()) @db.Uuid
  websiteId         String   @unique @db.Uuid
  templateReleaseId String   @db.Uuid
  contentDocument   Json     @db.JsonB
  revisionNumber    Int      @default(1)
  updatedByUserId   String   @db.Uuid
  updatedAt         DateTime @updatedAt

  website         Website                @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  templateRelease WebsiteTemplateRelease @relation(fields: [templateReleaseId], references: [id], onDelete: Restrict)
  updatedBy       User                   @relation(fields: [updatedByUserId], references: [id], onDelete: Restrict)

  @@map("website_draft")
}

model WebsiteVersion {
  id                String   @id @default(uuid()) @db.Uuid
  websiteId         String   @db.Uuid
  versionNumber     Int
  templateReleaseId String   @db.Uuid
  contentSnapshot   Json     @db.JsonB
  publishedAt       DateTime @default(now())
  publishedByUserId String   @db.Uuid
  sourceVersionId   String?  @db.Uuid

  website           Website                @relation("WebsiteVersions", fields: [websiteId], references: [id], onDelete: Cascade)
  templateRelease   WebsiteTemplateRelease @relation(fields: [templateReleaseId], references: [id], onDelete: Restrict)
  publishedBy       User                   @relation(fields: [publishedByUserId], references: [id], onDelete: Restrict)
  sourceVersion     WebsiteVersion?        @relation("WebsiteVersionSource", fields: [sourceVersionId], references: [id], onDelete: SetNull)
  derivedVersions   WebsiteVersion[]       @relation("WebsiteVersionSource")
  currentForWebsite Website?               @relation("WebsiteCurrentPublishedVersion")

  @@unique([websiteId, versionNumber])
  @@index([websiteId, publishedAt])
  @@map("website_version")
}

model WebsiteDomain {
  id                 String                   @id @default(uuid()) @db.Uuid
  websiteId          String                   @db.Uuid
  domainName         String                   @unique
  domainType         WebsiteDomainType
  verificationStatus DomainVerificationStatus @default(PENDING)
  activationStatus   DomainActivationStatus   @default(INACTIVE)
  verifiedAt         DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([websiteId])
  @@index([verificationStatus, activationStatus])
  @@map("website_domain")
}

// Module 04 - Catalogue & Category-Specific Data

model CatalogueCategory {
  id             String                  @id @default(uuid()) @db.Uuid
  organizationId String                  @db.Uuid
  name           String
  slug           String
  catalogueType  CatalogueType
  sortOrder      Int                     @default(0)
  status         CatalogueCategoryStatus @default(ACTIVE)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products      Product[]
  salonServices SalonService[]

  @@unique([organizationId, slug])
  @@index([organizationId, catalogueType, status])
  @@map("catalogue_category")
}

model Product {
  id                 String                      @id @default(uuid()) @db.Uuid
  organizationId     String                      @db.Uuid
  categoryId         String?                     @db.Uuid
  name               String
  slug               String
  description        String?
  pricingType        PricingType                 @default(FIXED)
  basePrice          Decimal?                    @db.Decimal(10, 2)
  minimumPrice       Decimal?                    @db.Decimal(10, 2)
  maximumPrice       Decimal?                    @db.Decimal(10, 2)
  availabilityStatus CatalogueAvailabilityStatus @default(AVAILABLE)
  sortOrder          Int                         @default(0)
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt
  archivedAt         DateTime?

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category     CatalogueCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants     ProductVariant[]
  images       ProductImage[]

  @@unique([organizationId, slug])
  @@index([organizationId, availabilityStatus, archivedAt])
  @@index([categoryId])
  @@map("product")
}

model ProductVariant {
  id                 String                      @id @default(uuid()) @db.Uuid
  productId          String                      @db.Uuid
  size               String?
  colour             String?
  sku                String?
  priceOverride      Decimal?                    @db.Decimal(10, 2)
  availabilityStatus CatalogueAvailabilityStatus @default(AVAILABLE)
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt
  archivedAt         DateTime?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, sku])
  @@index([productId, availabilityStatus, archivedAt])
  @@map("product_variant")
}

model SalonService {
  id                 String                      @id @default(uuid()) @db.Uuid
  organizationId     String                      @db.Uuid
  categoryId         String?                     @db.Uuid
  name               String
  slug               String
  description        String?
  pricingType        PricingType                 @default(FIXED)
  basePrice          Decimal?                    @db.Decimal(10, 2)
  minimumPrice       Decimal?                    @db.Decimal(10, 2)
  maximumPrice       Decimal?                    @db.Decimal(10, 2)
  durationMinutes    Int?
  availabilityStatus CatalogueAvailabilityStatus @default(AVAILABLE)
  sortOrder          Int                         @default(0)
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt
  archivedAt         DateTime?

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category     CatalogueCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images       ServiceImage[]
  bookings     Booking[]

  @@unique([organizationId, slug])
  @@index([organizationId, availabilityStatus, archivedAt])
  @@index([categoryId])
  @@map("salon_service")
}

model ProductImage {
  id           String              @id @default(uuid()) @db.Uuid
  productId    String              @db.Uuid
  mediaAssetId String              @db.Uuid
  sortOrder    Int                 @default(0)
  role         CatalogueImageRole?

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)

  @@index([productId, sortOrder])
  @@index([mediaAssetId])
  @@map("product_image")
}

model ServiceImage {
  id           String              @id @default(uuid()) @db.Uuid
  serviceId    String              @db.Uuid
  mediaAssetId String              @db.Uuid
  sortOrder    Int                 @default(0)
  role         CatalogueImageRole?

  service    SalonService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset   @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)

  @@index([serviceId, sortOrder])
  @@index([mediaAssetId])
  @@map("service_image")
}

// Module : 05 - Media & File Assets

model MediaAsset {
  id               String                @id @default(uuid()) @db.Uuid
  organizationId   String                @db.Uuid
  uploadedByUserId String?               @db.Uuid
  storageKey       String                @unique
  originalFileName String
  mimeType         String
  fileSizeBytes    BigInt
  mediaType        MediaType
  width            Int?
  height           Int?
  processingStatus MediaProcessingStatus @default(PENDING)
  accessLevel      MediaAccessLevel      @default(PRIVATE)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  deletedAt        DateTime?

  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedBy           User?                 @relation(fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  variants             MediaVariant[]
  businessProfiles     BusinessProfile[]
  productImages        ProductImage[]
  serviceImages        ServiceImage[]
  aiContentGenerations AIContentGeneration[]
  whatsAppMessages     WhatsAppMessage[]

  @@index([organizationId, mediaType, deletedAt])
  @@index([organizationId, processingStatus])
  @@index([uploadedByUserId])
  @@map("media_asset")
}

model MediaVariant {
  id            String           @id @default(uuid()) @db.Uuid
  mediaAssetId  String           @db.Uuid
  variantType   MediaVariantType
  storageKey    String           @unique
  mimeType      String
  fileSizeBytes BigInt
  width         Int?
  height        Int?
  createdAt     DateTime         @default(now())

  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@unique([mediaAssetId, variantType])
  @@index([mediaAssetId])
  @@map("media_variant")
}

// Module 06 - Leads & CRM

model Lead {
  id              String         @id @default(uuid()) @db.Uuid
  organizationId  String         @db.Uuid
  customerName    String?
  phone           String?
  email           String?
  message         String
  source          LeadSource
  contactChannel  ContactChannel
  status          LeadStatus     @default(NEW)
  createdByUserId String?        @db.Uuid
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  archivedAt      DateTime?

  organization          Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy             User?                  @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  followUps             LeadFollowUp[]
  notes                 LeadNote[]
  bookings              Booking[]
  whatsAppConversations WhatsAppConversation[]

  @@index([organizationId, status, archivedAt])
  @@index([organizationId, createdAt])
  @@map("lead")
}

model LeadFollowUp {
  id              String             @id @default(uuid()) @db.Uuid
  organizationId  String             @db.Uuid
  leadId          String             @db.Uuid
  title           String
  dueAt           DateTime
  status          LeadFollowUpStatus @default(PENDING)
  completedAt     DateTime?
  createdByUserId String             @db.Uuid
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdBy    User         @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, status, dueAt])
  @@index([leadId, status])
  @@map("lead_follow_up")
}

model LeadNote {
  id              String    @id @default(uuid()) @db.Uuid
  organizationId  String    @db.Uuid
  leadId          String    @db.Uuid
  createdByUserId String    @db.Uuid
  content         String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdBy    User         @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([leadId, createdAt])
  @@index([organizationId])
  @@map("lead_note")
}

// Module 07 - Salon Availability & Bookings

model AvailabilitySlot {
  id              String                 @id @default(uuid()) @db.Uuid
  organizationId  String                 @db.Uuid
  startsAt        DateTime
  endsAt          DateTime
  status          AvailabilitySlotStatus @default(AVAILABLE)
  createdByUserId String                 @db.Uuid
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  bookings     Booking[]

  @@index([organizationId, startsAt, endsAt])
  @@index([organizationId, status, startsAt])
  @@map("availability_slot")
}

model Booking {
  id                 String        @id @default(uuid()) @db.Uuid
  organizationId     String        @db.Uuid
  serviceId          String        @db.Uuid
  availabilitySlotId String        @db.Uuid
  customerName       String
  customerPhone      String
  customerEmail      String?
  startsAt           DateTime
  endsAt             DateTime
  status             BookingStatus @default(PENDING)
  customerMessage    String?
  leadId             String?       @db.Uuid
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  service          SalonService      @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  availabilitySlot AvailabilitySlot  @relation(fields: [availabilitySlotId], references: [id], onDelete: Restrict)
  lead             Lead?             @relation(fields: [leadId], references: [id], onDelete: SetNull)
  activities       BookingActivity[]

  @@index([organizationId, startsAt, status])
  @@index([availabilitySlotId, status])
  @@index([serviceId])
  @@index([leadId])
  @@map("booking")
}

model BookingActivity {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @db.Uuid
  bookingId      String              @db.Uuid
  actorUserId    String?             @db.Uuid
  activityType   BookingActivityType
  details        Json                @db.JsonB
  createdAt      DateTime            @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  booking      Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  actor        User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([bookingId, createdAt])
  @@index([organizationId, createdAt])
  @@map("booking_activity")
}

// Module 08 - AI Studio & Content Management

model AIContentGeneration {
  id              String                    @id @default(uuid()) @db.Uuid
  organizationId  String                    @db.Uuid
  createdByUserId String                    @db.Uuid
  conversationId  String?                   @db.Uuid
  contentType     AIContentType
  prompt          String
  responseText    String?
  mediaAssetId    String?                   @db.Uuid
  status          AIContentGenerationStatus @default(PENDING)
  errorCode       String?
  isSaved         Boolean                   @default(false)
  createdAt       DateTime                  @default(now())
  completedAt     DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  mediaAsset   MediaAsset?  @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([organizationId, isSaved, createdAt])
  @@index([status, createdAt])
  @@index([createdByUserId])
  @@map("ai_content_generation")
}

// Module 09 - Notifications & Devices

model Notification {
  id                String           @id @default(uuid()) @db.Uuid
  organizationId    String?          @db.Uuid
  recipientUserId   String           @db.Uuid
  notificationType  NotificationType
  title             String
  body              String
  relatedEntityType String?
  relatedEntityId   String?
  readAt            DateTime?
  createdAt         DateTime         @default(now())
  expiresAt         DateTime?

  organization Organization?          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recipient    User                   @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)
  deliveries   NotificationDelivery[]

  @@index([recipientUserId, readAt, createdAt])
  @@index([organizationId, createdAt])
  @@index([expiresAt])
  @@map("notification")
}

model NotificationDelivery {
  id                String                     @id @default(uuid()) @db.Uuid
  notificationId    String                     @db.Uuid
  channel           NotificationChannel
  status            NotificationDeliveryStatus @default(PENDING)
  attemptCount      Int                        @default(0)
  nextAttemptAt     DateTime?
  sentAt            DateTime?
  deliveredAt       DateTime?
  providerMessageId String?
  failureCode       String?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([notificationId, channel])
  @@index([status, nextAttemptAt])
  @@index([providerMessageId])
  @@map("notification_delivery")
}

model OutboxEvent {
  id             String            @id @default(uuid()) @db.Uuid
  eventType      String
  organizationId String?           @db.Uuid
  aggregateType  String
  aggregateId    String            @db.Uuid
  payload        Json              @db.JsonB
  status         OutboxEventStatus @default(PENDING)
  attemptCount   Int               @default(0)
  createdAt      DateTime          @default(now())
  processedAt    DateTime?
  nextAttemptAt  DateTime          @default(now())
  lastErrorCode  String?

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([status, nextAttemptAt])
  @@index([organizationId, createdAt])
  @@index([aggregateType, aggregateId])
  @@map("outbox_event")
}

// Module 10 - Integrations & Social Hub

model IntegrationAccount {
  id                String                   @id @default(uuid()) @db.Uuid
  organizationId    String                   @db.Uuid
  provider          IntegrationProvider
  externalAccountId String
  displayName       String?
  status            IntegrationAccountStatus @default(CONNECTED)
  connectedByUserId String                   @db.Uuid
  connectedAt       DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  disconnectedAt    DateTime?
  lastValidatedAt   DateTime?

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connectedBy  User                    @relation(fields: [connectedByUserId], references: [id], onDelete: Restrict)
  credentials  IntegrationCredential[]
  resources    IntegrationResource[]
  syncJobs     IntegrationSyncJob[]

  @@unique([organizationId, provider, externalAccountId])
  @@index([organizationId, status])
  @@map("integration_account")
}

model IntegrationCredential {
  id                   String    @id @default(uuid()) @db.Uuid
  integrationAccountId String    @db.Uuid
  credentialReference  String
  tokenExpiresAt       DateTime?
  grantedScopes        String[]  @default([])
  lastRefreshedAt      DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  revokedAt            DateTime?

  integrationAccount IntegrationAccount @relation(fields: [integrationAccountId], references: [id], onDelete: Cascade)

  @@index([integrationAccountId, revokedAt])
  @@map("integration_credential")
}

model IntegrationResource {
  id                   String                    @id @default(uuid()) @db.Uuid
  organizationId       String                    @db.Uuid
  integrationAccountId String                    @db.Uuid
  resourceType         String
  externalResourceId   String
  displayName          String?
  status               IntegrationResourceStatus @default(ACTIVE)
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  organization       Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  integrationAccount IntegrationAccount          @relation(fields: [integrationAccountId], references: [id], onDelete: Cascade)
  syncJobs           IntegrationSyncJob[]
  metricSnapshots    IntegrationMetricSnapshot[]

  @@unique([integrationAccountId, resourceType, externalResourceId])
  @@index([organizationId, status])
  @@map("integration_resource")
}

model IntegrationSyncJob {
  id                    String                @id @default(uuid()) @db.Uuid
  organizationId        String                @db.Uuid
  integrationAccountId  String                @db.Uuid
  integrationResourceId String?               @db.Uuid
  jobType               String
  status                IntegrationSyncStatus @default(PENDING)
  attemptCount          Int                   @default(0)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  startedAt             DateTime?
  completedAt           DateTime?
  nextAttemptAt         DateTime?
  errorCode             String?

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  integrationAccount  IntegrationAccount   @relation(fields: [integrationAccountId], references: [id], onDelete: Cascade)
  integrationResource IntegrationResource? @relation(fields: [integrationResourceId], references: [id], onDelete: SetNull)

  @@index([status, nextAttemptAt])
  @@index([organizationId, createdAt])
  @@index([integrationAccountId, status])
  @@map("integration_sync_job")
}

model IntegrationMetricSnapshot {
  id                    String   @id @default(uuid()) @db.Uuid
  organizationId        String   @db.Uuid
  integrationResourceId String   @db.Uuid
  metricType            String
  periodStart           DateTime
  periodEnd             DateTime
  value                 Decimal  @db.Decimal(20, 4)
  retrievedAt           DateTime @default(now())
  sourceMetadata        Json?    @db.JsonB

  organization        Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  integrationResource IntegrationResource @relation(fields: [integrationResourceId], references: [id], onDelete: Cascade)

  @@unique([integrationResourceId, metricType, periodStart, periodEnd])
  @@index([organizationId, metricType, periodStart])
  @@map("integration_metric_snapshot")
}

model WhatsAppConversation {
  id             String                     @id @default(uuid()) @db.Uuid
  organizationId String                     @db.Uuid
  customerPhone  String
  customerName   String?
  leadId         String?                    @db.Uuid
  status         WhatsAppConversationStatus @default(OPEN)
  lastMessageAt  DateTime?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead?             @relation(fields: [leadId], references: [id], onDelete: SetNull)
  messages     WhatsAppMessage[]

  @@index([organizationId, status, lastMessageAt])
  @@index([leadId])
  @@map("whatsapp_conversation")
}

model WhatsAppMessage {
  id                String                   @id @default(uuid()) @db.Uuid
  conversationId    String                   @db.Uuid
  direction         WhatsAppMessageDirection
  contentType       WhatsAppContentType
  body              String?
  mediaAssetId      String?                  @db.Uuid
  providerMessageId String?                  @unique
  status            WhatsAppMessageStatus    @default(PENDING)
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  failureCode       String?
  createdAt         DateTime                 @default(now())

  conversation WhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  mediaAsset   MediaAsset?          @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@index([status, createdAt])
  @@map("whatsapp_message")
}

// Module 11 - Plans, Subscriptions, Entitlements & Usage

model Plan {
  id          String     @id @default(uuid()) @db.Uuid
  code        String     @unique
  name        String
  description String?
  status      PlanStatus @default(ACTIVE)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  prices        PlanPrice[]
  entitlements  PlanEntitlement[]
  subscriptions Subscription[]

  @@map("plan")
}

model PlanPrice {
  id              String          @id @default(uuid()) @db.Uuid
  planId          String          @db.Uuid
  amount          Decimal         @db.Decimal(10, 2)
  currency        String          @default("INR")
  billingInterval BillingInterval
  effectiveFrom   DateTime
  effectiveUntil  DateTime?
  status          PlanPriceStatus @default(ACTIVE)
  createdAt       DateTime        @default(now())

  plan          Plan           @relation(fields: [planId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]

  @@index([planId, status, effectiveFrom])
  @@map("plan_price")
}

model PlanEntitlement {
  id          String   @id @default(uuid()) @db.Uuid
  planId      String   @db.Uuid
  featureCode String
  enabled     Boolean  @default(true)
  limitValue  Decimal? @db.Decimal(12, 2)
  limitUnit   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, featureCode])
  @@map("plan_entitlement")
}

model Subscription {
  id                 String             @id @default(uuid()) @db.Uuid
  organizationId     String             @db.Uuid
  planId             String             @db.Uuid
  planPriceId        String             @db.Uuid
  status             SubscriptionStatus @default(ACTIVE)
  startedAt          DateTime           @default(now())
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  gracePeriodEndsAt  DateTime?
  cancelAtPeriodEnd  Boolean            @default(false)
  cancelledAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         Plan          @relation(fields: [planId], references: [id], onDelete: Restrict)
  planPrice    PlanPrice     @relation(fields: [planPriceId], references: [id], onDelete: Restrict)
  invoiceLines InvoiceLine[]

  @@index([organizationId, status])
  @@index([status, currentPeriodEnd])
  @@map("subscription")
}

model UsageRecord {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  featureCode    String
  quantity       Decimal  @db.Decimal(12, 2)
  unit           String
  occurredAt     DateTime @default(now())
  periodStart    DateTime
  periodEnd      DateTime
  sourceType     String?
  sourceId       String?  @db.Uuid
  idempotencyKey String?  @unique

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, featureCode, periodStart, periodEnd])
  @@index([occurredAt])
  @@map("usage_record")
}

// Module 12 - Payments & Billing Records

model PaymentCustomer {
  id                 String                @id @default(uuid()) @db.Uuid
  organizationId     String                @db.Uuid
  provider           PaymentProvider
  externalCustomerId String
  status             PaymentCustomerStatus @default(ACTIVE)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payments     Payment[]

  @@unique([provider, externalCustomerId])
  @@index([organizationId, status])
  @@map("payment_customer")
}

model Payment {
  id                String          @id @default(uuid()) @db.Uuid
  organizationId    String          @db.Uuid
  paymentCustomerId String?         @db.Uuid
  provider          PaymentProvider
  externalPaymentId String?
  purpose           PaymentPurpose
  amount            Decimal         @db.Decimal(12, 2)
  currency          String          @default("INR")
  status            PaymentStatus   @default(PENDING)
  idempotencyKey    String?         @unique
  initiatedAt       DateTime        @default(now())
  succeededAt       DateTime?
  failureCode       String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  organization    Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  paymentCustomer PaymentCustomer?       @relation(fields: [paymentCustomerId], references: [id], onDelete: SetNull)
  allocations     PaymentAllocation[]
  providerEvents  PaymentProviderEvent[]

  @@unique([provider, externalPaymentId])
  @@index([organizationId, status, createdAt])
  @@index([paymentCustomerId])
  @@map("payment")
}

model Invoice {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  invoiceNumber  String
  status         InvoiceStatus @default(DRAFT)
  currency       String        @default("INR")
  subtotalAmount Decimal       @db.Decimal(12, 2)
  taxAmount      Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal       @db.Decimal(12, 2)
  issuedAt       DateTime
  dueAt          DateTime?
  paidAt         DateTime?
  voidedAt       DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lines        InvoiceLine[]
  allocations  PaymentAllocation[]

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId, status, issuedAt])
  @@map("invoice")
}

model InvoiceLine {
  id                    String          @id @default(uuid()) @db.Uuid
  invoiceId             String          @db.Uuid
  description           String
  itemType              InvoiceItemType
  quantity              Decimal         @db.Decimal(12, 2)
  unitAmount            Decimal         @db.Decimal(12, 2)
  taxAmount             Decimal         @default(0) @db.Decimal(12, 2)
  lineTotal             Decimal         @db.Decimal(12, 2)
  relatedSubscriptionId String?         @db.Uuid
  relatedServiceId      String?         @db.Uuid
  createdAt             DateTime        @default(now())

  invoice             Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  relatedSubscription Subscription? @relation(fields: [relatedSubscriptionId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([relatedSubscriptionId])
  @@map("invoice_line")
}

model PaymentAllocation {
  id              String   @id @default(uuid()) @db.Uuid
  paymentId       String   @db.Uuid
  invoiceId       String   @db.Uuid
  allocatedAmount Decimal  @db.Decimal(12, 2)
  createdAt       DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([paymentId, invoiceId])
  @@index([invoiceId])
  @@map("payment_allocation")
}

model PaymentProviderEvent {
  id               String                     @id @default(uuid()) @db.Uuid
  provider         PaymentProvider
  externalEventId  String
  eventType        String
  receivedAt       DateTime                   @default(now())
  processedAt      DateTime?
  processingStatus PaymentProviderEventStatus @default(PENDING)
  attemptCount     Int                        @default(0)
  relatedPaymentId String?                    @db.Uuid
  relatedRefundId  String?                    @db.Uuid
  failureCode      String?

  relatedPayment Payment? @relation(fields: [relatedPaymentId], references: [id], onDelete: SetNull)

  @@unique([provider, externalEventId])
  @@index([processingStatus, receivedAt])
  @@index([relatedPaymentId])
  @@map("payment_provider_event")
}

// Module 13 - Managed Services Inquiry Form

model ServiceInquiry {
  id                  String               @id @default(uuid()) @db.Uuid
  merchantName        String
  businessName        String?
  phone               String
  email               String?
  serviceInterestedIn String
  message             String
  status              ServiceInquiryStatus @default(NEW)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([status, createdAt])
  @@index([phone])
  @@map("service_inquiry")
}

// Module 14 - Analytics, Audit & Operational History

model AuditLog {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String?        @db.Uuid
  actorUserId    String?        @db.Uuid
  actorType      AuditActorType
  action         String
  entityType     String
  entityId       String?
  details        Json?          @db.JsonB
  ipAddress      String?
  createdAt      DateTime       @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actor        User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([entityType, entityId])
  @@index([action, createdAt])
  @@map("audit_log")
}

